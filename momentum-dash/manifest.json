{
  "manifest_version": 3,
  "name": "Stillpoint",
  "version": "1.0.0",
  "description": "A quiet new tab with a live clock and a little inspiration.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://images.unsplash.com data:"
  }
}